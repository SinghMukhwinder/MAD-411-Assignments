<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainFragment">

    <RelativeLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <FrameLayout
            android:id="@+id/headerFragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"/>

        <EditText
            android:id="@+id/expenseText"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_below="@id/headerFragmentContainer"
            android:layout_margin="8dp"
            android:hint="@string/expense_name"/>

        <EditText
            android:id="@+id/amountText"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_below="@id/expenseText"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="8dp"
            android:hint="@string/amount"
            android:inputType="numberDecimal"
            android:padding="8dp"/>

        <LinearLayout
            android:id="@+id/conversionLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/amountText"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/costCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/conversion_needed"
                android:layout_marginEnd="12dp"/>

            <Spinner
                android:id="@+id/currencySpinner"
                android:layout_width="6dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:spinnerMode="dropdown" />
        </LinearLayout>

        <Button
            android:id="@+id/dateField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/conversionLayout"
            android:layout_margin="10dp"
            android:text="@string/select_date"/>

        <Button
            android:id="@+id/addExpenseBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/dateField"
            android:layout_margin="10dp"
            android:text="Add Expense"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_below="@id/addExpenseBtn"
            android:layout_above="@id/tipsButton"
            android:layout_margin="8dp"/>

        <Button
            android:id="@+id/tipsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_margin="10dp"
            android:text="@string/financial_tips"/>

        <FrameLayout
            android:id="@+id/footerFragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/tipsButton"
            android:layout_marginBottom="8dp"/>
    </RelativeLayout>

</FrameLayout>
